    "profilo.cancella.messaggio": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo, le nuotate e le scelte salvati dall'app verranno eliminati da questo dispositivo. I dati in Apple Salute non vengono toccati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile, swims and choices saved by the app will be deleted from this device. Data in Apple Health isn't touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil, los nados y las opciones guardados por la app se eliminarán de este dispositivo. Los datos de Apple Salud no se tocan."
          }
        }
      }
    },
    "profilo.coach": {
      "extractionState": "manual",
      "localizations": {
