    "riepilogo.carta.settimana": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mia settimana"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi semana"
          }
        }
      }
    },
    "riepilogo.commento.crescita": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo mese hai nuotato %@ m, più del mese scorso. Mi piace vederti così a tuo agio in acqua."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month you swam %@ m, more than last month. I love seeing you so at ease in the water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mes has nadado %@ m, más que el mes pasado. Me encanta verte tan a gusto en el agua."
          }
        }
      }
    },
    "riepilogo.commento.dure": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo mese qualche nuotata è sembrata più dura: succede a tutti. Quando ti va, si riparte con calma, al tuo passo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month some swims felt harder: it happens to everyone. Whenever you feel like it, we start again gently, at your pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mes algún nado se te ha hecho más duro: nos pasa a todos. Cuando te apetezca, retomamos con calma, a tu paso."
          }
        }
      }
    },
    "riepilogo.commento.generico": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo mese: %ld nuotate e %@ m. Grazie per il tempo che dedichi all'acqua."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month: %ld swims and %@ m. Thank you for the time you give to the water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mes: %ld nados y %@ m. Gracias por el tiempo que le dedicas al agua."
          }
        }
      }
    },
    "riepilogo.commento.serie": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %ld settimane di fila in cui trovi il tempo per nuotare. Si sente la tua costanza."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's %ld weeks in a row that you've found time to swim. Your consistency really shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %ld semanas seguidas en las que encuentras tiempo para nadar. Se nota tu constancia."
          }
        }
      }
    },
    "riepilogo.commento.titolo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il commento di %@ sul mese"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s comment on your month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comentario de %@ sobre el mes"
          }
        }
      }
    },
    "riepilogo.commento.una": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nuotata e %@ m questo mese. Ogni volta in acqua conta, e io sono qui quando vuoi tornare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One swim and %@ m this month. Every time in the water counts, and I'm here whenever you want to come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nado y %@ m este mes. Cada vez que entras al agua cuenta, y aquí estoy cuando quieras volver."
          }
        }
      }
    },
    "riepilogo.commento.vuoto": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora questo mese è tranquillo. Quando ti va di tornare in acqua, io ci sono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a quiet month so far. Whenever you feel like getting back in the water, I'm here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora este mes está tranquilo. Cuando te apetezca volver al agua, aquí estoy."
          }
        }
      }
    },
