          }
        }
      }
    },
    "maggiorenne.sottotitolo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una domanda veloce, poi cominciamo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One quick question, then we start."
          }
