    "asecco.avviso": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercizi leggeri: fermati se senti dolore e, se persiste, senti un medico."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle exercises: stop if you feel pain and, if it persists, see a doctor."
          }
        },
        "es": {
