    "maggiorenne.no.testo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora Swimwave è pensata per gli adulti, quindi non possiamo andare avanti. Non abbiamo raccolto nessun dato su di te. Ti aspettiamo quando avrai compiuto 18 anni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For now, Swimwave is made for adults, so we can't go any further. We haven't collected any data about you. We'll be here when you turn 18."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora Swimwave está pensada para adultos, así que no podemos continuar. No hemos recogido ningún dato sobre ti. Te esperamos cuando cumplas 18 años."
          }
        }
      }
    },
    "maggiorenne.no.titolo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per avercelo detto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for telling us"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por decírnoslo"
          }
        }
      }
    },
