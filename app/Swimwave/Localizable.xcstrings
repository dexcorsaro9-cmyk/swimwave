    "retest.messaggio": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono passate %ld settimane dall'ultimo test: se vuoi, rifallo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's been %ld weeks since your last test: if you like, take it again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han pasado %ld semanas desde el último test: si quieres, repítelo"
          }
        }
      }
    },
    "retest.nota": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Negli allenamenti trovi i tempi obiettivo, calcolati sul tuo ritmo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your workouts you'll find target times, calculated from your pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los entrenamientos encuentras los tiempos objetivo, calculados según tu ritmo."
          }
        }
      }
    },
