    },
    "consenso.no": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se preferisci di no, nessun problema: ricevi allenamenti fissi preparati dal nostro team e una frase fissa al posto del commento sul mese."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you'd rather not, no problem: you'll get fixed workouts prepared by our team and a fixed sentence in place of the comment on your month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prefieres que no, no hay problema: recibes entrenamientos fijos preparados por nuestro equipo y una frase fija en lugar del comentario sobre el mes."
          }
        }
      }
    },
    "consenso.preferiscoNo": {
