    "andamento.ritmo.nota": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo medio di ogni nuotata di almeno 200 m, in minuti e secondi ogni 100 m. In alto i ritmi più veloci."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average pace of every swim of at least 200 m, in minutes and seconds per 100 m. Faster paces are at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo medio de cada nado de al menos 200 m, en minutos y segundos cada 100 m. Arriba, los ritmos más rápidos."
          }
        }
      }
    },
