    "consenso.cambio": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare idea quando vuoi, in Profilo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your mind anytime, in Profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar de opinión cuando quieras, en Perfil."
          }
        }
      }
    },
    "consenso.dati": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al servizio che li prepara arrivano solo il tuo livello, l'obiettivo, la vasca, il ritmo, il coach scelto e come ti è sembrato l'ultimo allenamento; e, se li scegli, la durata e l'obiettivo di quell'allenamento. Per il commento sul tuo mese arrivano solo alcuni totali: quante nuotate, quanti metri e minuti, le settimane di fila e quante nuotate ti sono sembrate facili, giuste o dure. Mai il tuo nome."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service that prepares them only receives your level, goal, pool, pace, the coach you chose, and how your last workout felt; and, if you choose them, the length and goal of that workout. For the comment on your month, it only receives a few totals: how many swims, how many meters and minutes, your weeks in a row, and how many swims felt easy, just right or hard. Never your name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al servicio que los prepara solo llegan tu nivel, el objetivo, la piscina, el ritmo, el coach elegido y cómo te pareció el último entrenamiento; y, si los eliges, la duración y el objetivo de ese entrenamiento. Para el comentario sobre tu mes llegan solo algunos totales: cuántos nados, cuántos metros y minutos, las semanas seguidas y cuántos nados te parecieron fáciles, justos o duros. Nunca tu nombre."
          }
        }
      }
    },
    "consenso.ia": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %@, un personaggio virtuale: non sono una persona reale. Gli allenamenti e il commento sul tuo mese li preparo con l'aiuto dell'intelligenza artificiale."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm %@, a virtual character: I'm not a real person. I prepare your workouts and the comment on your month with the help of artificial intelligence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy %@, un personaje virtual: no soy una persona real. Los entrenamientos y el comentario sobre tu mes los preparo con la ayuda de la inteligencia artificial."
          }
        }
      }
    },
    "consenso.maggioriInformazioni": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
