          "stringUnit": {
            "state": "translated",
            "value": "Respira y ve a tu ritmo."
          }
        }
      }
    },
    "guidato.frase.4": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni vasca conta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every length counts."
