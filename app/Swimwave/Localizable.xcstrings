    "profilo.ia.descrizione": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso: il coach prepara gli allenamenti con l'aiuto dell'intelligenza artificiale. Al servizio arrivano solo livello, obiettivo, vasca, ritmo, coach scelto e come è andato l'ultimo allenamento, mai il tuo nome. Spento: ricevi allenamenti fissi preparati dal nostro team."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: the coach prepares your workouts with the help of artificial intelligence. Only your level, goal, pool, pace, chosen coach and how your last workout went are sent to the service, never your name. Off: you get fixed workouts prepared by our team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: el coach prepara los entrenamientos con la ayuda de la inteligencia artificial. Al servicio solo llegan nivel, objetivo, piscina, ritmo, coach elegido y cómo fue el último entrenamiento, nunca tu nombre. Desactivado: recibes entrenamientos fijos preparados por nuestro equipo."
          }
        }
      }
    },
