    "ritmo.spronami.descrizione": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come Regolare, in più un promemoria sul telefono, al massimo uno al giorno, quando manca ancora qualcosa al tuo obiettivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like Steady, plus a reminder on your phone, one a day at most, when something is still missing from your goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como Regular, y además un recordatorio en el teléfono, como máximo uno al día, cuando aún falta algo para tu objetivo."
          }
        }
      }
    },
    "ritmo.tempi.nota": {
