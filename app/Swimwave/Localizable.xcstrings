    "ritmo.nonPlausibile": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricontrolla i tempi: il 400 dovrebbe richiedere più del doppio del 200. Puoi rifare il test quando vuoi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-check your times: the 400 should take more than twice as long as the 200. You can retake the test anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los tiempos: el de 400 debería llevar más del doble que el de 200. Puedes repetir el test cuando quieras."
          }
        }
      }
    },
    "ritmo.regolare": {
