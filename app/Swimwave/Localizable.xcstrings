    },
    "guidato.frase.3": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira e vai al tuo ritmo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe and go at your own pace."
          }
        },
