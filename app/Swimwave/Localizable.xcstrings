    "ritmo.libero.descrizione": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun obiettivo e nessun sollecito. Trovi la proposta adatta a oggi quando apri l'app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No goal and no nudges. You'll find today's suggested workout when you open the app."
          }
        },
