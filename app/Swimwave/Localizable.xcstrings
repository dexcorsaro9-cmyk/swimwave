      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Antonio e Pamela sono coach virtuali creati con l'intelligenza artificiale, non persone reali. Il metodo è controllato da un istruttore di nuoto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Antonio and Pamela are virtual coaches created with artificial intelligence, not real people. The method is reviewed by a swim instructor."
