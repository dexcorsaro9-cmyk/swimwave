    "permesso.notifiche.frase1": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai scelto Spronami: se me lo permetti, ti scrivo un promemoria al giorno al massimo, e solo se manca ancora qualcosa al tuo obiettivo della settimana."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chose Spronami: if you allow it, I'll send you one reminder a day at most, and only if something is still missing from your weekly goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has elegido Spronami: si me lo permites, te escribo un recordatorio al día como máximo, y solo si aún falta algo para tu objetivo de la semana."
          }
        }
      }
    },
    "permesso.notifiche.frase2": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente fretta e niente colpe: se un giorno non si può, pazienza. I promemoria restano sul tuo telefono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rush and no guilt: if one day isn't possible, that's fine. Reminders stay on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin prisa y sin culpas: si un día no se puede, no pasa nada. Los recordatorios se quedan en tu teléfono."
          }
        }
      }
    },
    "permesso.notifiche.nota": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi spegnerli quando vuoi, in Impostazioni o cambiando ritmo dal Profilo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn them off anytime, in Settings or by changing your pace in Profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes desactivarlos cuando quieras, en Ajustes o cambiando de ritmo desde el Perfil."
          }
        }
      }
    },
    "permesso.notifiche.titolo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria, quando vuoi tu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder, when you want it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio, cuando tú quieras"
          }
        }
      }
    },
    "permesso.piuTardi": {
      "extractionState": "manual",
      "localizations": {
