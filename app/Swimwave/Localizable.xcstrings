      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai scelto Spronami: se me lo permetti, ti scrivo un promemoria al giorno al massimo, e solo se manca ancora qualcosa al tuo obiettivo della settimana."
          }
        }
      }
    },
    "permesso.notifiche.frase2": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente fretta e niente colpe: se un giorno non si può, pazienza. I promemoria restano sul tuo telefono."
          }
        }
      }
    },
    "permesso.notifiche.nota": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi spegnerli quando vuoi, in Impostazioni o cambiando ritmo dal Profilo."
