    },
    "permesso.salute.frase1": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se me lo permetti, leggo da Apple Salute le nuotate fatte con altre app e con il tuo orologio, così le trovi anche qui."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow it, I'll read the swims you did with other apps and with your watch from Apple Health, so you can find them here too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si me lo permites, leo de Apple Salud los nados hechos con otras apps y con tu reloj, para que los tengas también aquí."
          }
        }
      }
    },
    "permesso.salute.frase2": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano sul tuo telefono: non le condivido con nessuno e non servono per la pubblicità."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They stay on your phone: I don't share them with anyone and they're not used for advertising."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quedan en tu teléfono: no los comparto con nadie y no se usan para publicidad."
          }
        }
      }
    },
    "permesso.salute.nota": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare idea quando vuoi in Impostazioni, Salute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your mind anytime in Settings, Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar de opinión cuando quieras en Ajustes, Salud."
          }
        }
      }
    },
    "permesso.salute.titolo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue nuotate, tutte insieme"
