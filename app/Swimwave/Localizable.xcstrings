    "chiedi.consenso": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per scriverti un allenamento su misura mi serve l'uso dell'IA. Se vuoi, lo attivi in Profilo, quando preferisci: nessuna fretta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To write a workout just for you, I need to use AI. If you like, you can turn it on in Profile whenever you prefer: no rush."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escribirte un entrenamiento a tu medida necesito usar la IA. Si quieres, la activas en Perfil cuando prefieras: sin prisa."
          }
        }
      }
    },
