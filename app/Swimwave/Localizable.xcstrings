    },
    "guidato.frase.6": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se senti dolore, fermati e riposa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you feel pain, stop and rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sientes dolor, detente y descansa."
          }
        }
      }
    },
    "guidato.frase.7": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna fretta: rallenta pure se serve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rush: slow down if you need to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin prisa: baja el ritmo si hace falta."
          }
        }
      }
    },
    "guidato.frase.8": {
      "extractionState": "manual",
