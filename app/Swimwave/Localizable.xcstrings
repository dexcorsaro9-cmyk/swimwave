          }
        }
      }
    },
    "maggiorenne.spiegazione": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora Swimwave è pensata per le persone maggiorenni. Basta un tocco: non ti chiediamo nessun documento."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For now, Swimwave is made for adults. One tap is enough: we won't ask for any documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora Swimwave está pensada para personas mayores de edad. Basta un toque: no te pedimos ningún documento."
          }
        }
      }
    },
