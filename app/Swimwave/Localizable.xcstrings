    "popup.dopoAllenamentoDuro.messaggio": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi hai dato tanto, %@. Riposati con calma: il prossimo allenamento lo facciamo più leggero, se vuoi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You gave a lot today, %@. Rest up and take it easy: we'll make the next workout lighter, if you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy has dado mucho, %@. Descansa con calma: el próximo entrenamiento lo hacemos más suave, si quieres."
          }
        }
      }
    },
    "popup.ripartenza.messaggio": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripartiamo con calma, senza fretta. Ti aspetto in acqua."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's start again gently, no rush. I'll see you in the water."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retomamos con calma, sin prisa. Te espero en el agua."
          }
        }
      }
    },
