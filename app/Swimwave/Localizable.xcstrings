    "info.coach.testo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Antonio e Pamela sono coach virtuali: personaggi inventati, creati con l'intelligenza artificiale, che seguono il metodo di un istruttore di nuoto. Hanno la stessa competenza e lo stesso tono. Puoi cambiare coach quando vuoi dal Profilo, senza perdere lo storico."
          }
        }
      }
    },
    "info.coach.titolo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I coach"
          }
        }
      }
    },
    "info.dati.testo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo e le nuotate restano sul tuo dispositivo. Puoi cancellarli in qualsiasi momento dal Profilo. I dati di Apple Salute restano il più possibile sul dispositivo."
          }
        }
      }
    },
    "info.dati.titolo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati"
          }
        }
      }
    },
    "info.ia.testo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allenamento di oggi può essere preparato da un'intelligenza artificiale che segue regole scritte dall'istruttore e usa solo esercizi di una lista scelta da lui. Se qualcosa non funziona, l'app usa un allenamento fisso."
          }
        }
      }
    },
    "info.ia.titolo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligenza artificiale"
          }
        }
      }
    },
    "info.salute.testo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Swimwave non fa diagnosi e non sostituisce un medico. Se senti dolore, fermati e riposa. Se non passa, parlane con il tuo medico o con un professionista."
          }
        }
      }
    },
    "info.salute.titolo": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salute e sicurezza"
          }
        }
      }
    },
    "info.segnaposto": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo provvisorio: le informazioni complete su intelligenza artificiale, dati e privacy arriveranno prima del rilascio."
          }
        }
      }
    },
