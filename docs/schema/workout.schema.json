{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dexcorsaro9-cmyk/swimwave/docs/schema/workout.schema.json",
  "title": "Allenamento Swimwave",
  "description": "Contratto tra coach IA, iPhone e Apple Watch. Vedi docs/WORKOUT_FORMAT.md. Le regole che lo schema non può esprimere (distanze multiple della vasca, drill nella lista chiusa) sono nei validatori.",
  "type": "object",
  "additionalProperties": false,
  "required": ["titolo", "vasca_metri", "durata_stimata_min", "blocchi"],
  "properties": {
    "titolo": { "type": "string", "minLength": 1, "maxLength": 80 },
    "vasca_metri": { "type": "integer", "minimum": 10, "maximum": 100 },
    "durata_stimata_min": { "type": "integer", "minimum": 5, "maximum": 180 },
    "blocchi": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/definitions/blocco" }
    }
  },
  "definitions": {
    "blocco": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "serie"],
      "properties": {
        "tipo": { "enum": ["riscaldamento", "tecnica", "principale", "defaticamento"] },
        "serie": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/definitions/serie" }
        }
      }
    },
    "serie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ripetizioni", "distanza_m", "stile"],
      "properties": {
        "ripetizioni": { "type": "integer", "minimum": 1, "maximum": 50 },
        "distanza_m": { "type": "integer", "minimum": 10, "maximum": 2000 },
        "stile": { "enum": ["libero", "dorso", "rana", "delfino", "misto"] },
        "intensita": { "enum": ["facile", "media", "forte"] },
        "drill": { "type": "string", "minLength": 1, "maxLength": 60 },
        "recupero_s": { "type": "integer", "minimum": 0, "maximum": 600 }
      }
    }
  }
}
